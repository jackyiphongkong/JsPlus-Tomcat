<?xml version="1.0" ?>
<project name="JsPlus-Tomcat" default="build" basedir=".">
	<property environment="env" />
	<property name="jr.charset" value="UTF-8" />
	<property name="jr.root" location="./" />
	<property name="jr.src" value="${jr.root}/src" />
	<property name="jr.lib" value="${jr.root}/LibHome/" />
	<property name="jr.build" value="${jr.root}/build/" />
	<property name="jr.classes" value="${jr.build}/classes" />
	<property name="jr.tomcatserver" value="${jr.src}/com/killcoding/jsplus/tomcat/TomcatServer.java" />

	<!-- build/version.properties keeps the build version across builds
	     (automatic memory: patch is incremented by 1 on every ant build).
	     The three keys are created once on the first build, then jr.patch
	     is bumped; jr.major / jr.minor are only changed by hand. -->
	<condition property="jr.version.file.exists">
		<available file="${jr.root}/version.properties" />
	</condition>

	<!-- changes.log: per-build history (English + Traditional-Chinese copies).
	     Every successful `ant` (build target) appends one line to both files:
	     version + timestamp + optional -Dchange.note text. -->
	<property name="jr.changelog" value="${jr.root}/changes.log" />
	<property name="jr.changelog.zh" value="${jr.root}/changes_zh-HK.log" />
	<property name="jr.changenote" value="" />
	<condition property="jr.changelog.exists">
		<available file="${jr.changelog}" />
	</condition>
	<condition property="jr.changelog.zh.exists">
		<available file="${jr.changelog.zh}" />
	</condition>

	<!-- Githubrepos mirror path used by the diff-check step: after every build,
	     compare this Working tree's src/ java files against the mirror and
	     append any differences to changes.log marked "found diffed". Read-only —
	     nothing is copied or committed. -->
	<property name="jr.git.repo" value="D:/Githubrepos/JsPlus-Tomcat" />
	<condition property="is.windows">
		<os family="windows" />
	</condition>

	<path id="classpath">
		<fileset dir="${jr.lib}">
			<include name="**/*.jar" />
		</fileset>
	</path>

	<target name="version-init" unless="jr.version.file.exists">
		<mkdir dir="${jr.build}" />
		<propertyfile file="${jr.root}/version.properties">
			<entry key="jr.major" type="int" default="0" />
			<entry key="jr.minor" type="int" default="0" />
			<entry key="jr.patch" type="int" default="0" />
		</propertyfile>
	</target>

	<!-- Standard semver: jr.version = major.minor.patch, patch +1 every build.
	     Each segment is capped at 999; 999 + 1 carries into the next higher
	     segment (0.0.999 + 1 -> 0.1.0, 0.9.999 + 1 -> 1.0.0). NOTE: ant's
	     propertyfile formats ints with the locale (1000 -> "1,000"), which
	     would corrupt the file, so we never write a value of 1000: we check
	     for 999 first and carry directly. ant 1.9's propertyfile task has no
	     "if" attribute, so the bump is split into mutually exclusive targets
	     using target-level if/unless. -->
	<target name="version-flags" depends="version-init">
		<loadproperties srcFile="${jr.root}/version.properties" />
		<condition property="jr.patch.max">
			<matches string="${jr.patch}" pattern="999" />
		</condition>
		<condition property="jr.minor.max">
			<matches string="${jr.minor}" pattern="999" />
		</condition>
		<condition property="jr.carry.major">
			<and>
				<matches string="${jr.patch}" pattern="999" />
				<matches string="${jr.minor}" pattern="999" />
			</and>
		</condition>
	</target>

	<!-- case A: patch < 999 -> patch +1 -->
	<target name="bump-case-a" depends="version-flags" unless="jr.patch.max">
		<propertyfile file="${jr.root}/version.properties">
			<entry key="jr.patch" type="int" default="${jr.patch}" operation="+" />
		</propertyfile>
	</target>

	<!-- case B: patch=999 and minor < 999 -> patch=0, minor+1 -->
	<target name="bump-case-b" depends="version-flags" if="jr.patch.max" unless="jr.carry.major">
		<propertyfile file="${jr.root}/version.properties">
			<entry key="jr.patch" type="int" value="0" />
			<entry key="jr.minor" type="int" default="${jr.minor}" operation="+" />
		</propertyfile>
	</target>

	<!-- case C: patch=999 and minor=999 -> patch=0, minor=0, major+1 -->
	<target name="bump-case-c" depends="version-flags" if="jr.carry.major">
		<propertyfile file="${jr.root}/version.properties">
			<entry key="jr.patch" type="int" value="0" />
			<entry key="jr.minor" type="int" value="0" />
			<entry key="jr.major" type="int" default="${jr.major}" operation="+" />
		</propertyfile>
	</target>

	<target name="version-final" depends="bump-case-a,bump-case-b,bump-case-c">
		<loadproperties srcFile="${jr.root}/version.properties" />
		<property name="jr.version" value="${jr.major}.${jr.minor}.${jr.patch}" />
		<tstamp>
			<format property="jr.builddate" pattern="yyyy.MM.dd" />
		</tstamp>
		<echo message="Build version bumped to ${jr.version}" />
	</target>

	<target name="version-bump" depends="version-final" />

	<!-- Write the changes.log headers on the first build (English and
	     Traditional-Chinese copies; each is created only when missing so an
	     existing file is never overwritten). -->
	<target name="build-init-en" unless="jr.changelog.exists">
		<echo file="${jr.changelog}"
			message="# JsPlus-Tomcat build history${line.separator}# Format: version  timestamp  note${line.separator}#${line.separator}" />
	</target>
	<target name="build-init-zh" unless="jr.changelog.zh.exists">
		<echo file="${jr.changelog.zh}"
			message="# JsPlus-Tomcat 建置歷史${line.separator}# 格式：版本  時間  備註${line.separator}#${line.separator}" />
	</target>
	<target name="build-init" depends="build-init-en,build-init-zh" />

	<!-- Replace the ${BuildVersion.VERSION}(${BuildVersion.BUILD_DATE})
	     placeholders in TomcatServer.java with the real build values before
	     compilation. The regex first restores the placeholder in case a
	     previous build stopped before restoring it. -->
	<target name="replace-version" depends="version-bump">
		<replaceregexp file="${jr.tomcatserver}"
			match="[0-9]+\.[0-9]+\.[0-9]+ ?\([0-9]{4}\.[0-9]{2}\.[0-9]{2}\)"
			replace="${BuildVersion.VERSION}(${BuildVersion.BUILD_DATE})" byline="true" />
		<replace file="${jr.tomcatserver}"
			token="${BuildVersion.VERSION}(${BuildVersion.BUILD_DATE})"
			value="${jr.version}(${jr.builddate})" />
		<echo message="Replaced version placeholder with ${jr.version}(${jr.builddate}) in TomcatServer.java" />
	</target>

    <target name="clear">
		<delete dir="${jr.classes}" />
		<mkdir dir="${jr.classes}" />
	</target>

    <target name="compile" depends="clear,replace-version">
		<javac debug="true"  destdir="${jr.classes}" encoding="${jr.charset}" nowarn="true" includeantruntime="false">
			<src>
				<pathelement location="${jr.src}" />
			</src>
			<classpath refid="classpath" />
			<compilerarg line="-Xlint:-unchecked -Xlint:-deprecation"/>
			<compilerarg value="-Xlint:none"/>
		</javac>
		<copy todir="${jr.classes}">
			<fileset dir="${jr.src}">
				<exclude name="**/*.java" />
			</fileset>
		</copy>

		<!-- Restore the placeholders in TomcatServer.java immediately after
		     compilation, so the source always stays in placeholder form even
		     when only the compile target is run. -->
		<replaceregexp file="${jr.tomcatserver}"
			match="[0-9]+\.[0-9]+\.[0-9]+ ?\([0-9]{4}\.[0-9]{2}\.[0-9]{2}\)"
			replace="${BuildVersion.VERSION}(${BuildVersion.BUILD_DATE})" byline="true" />
		<echo message="Restored version placeholder in TomcatServer.java" />
	</target>


	<target name="package" depends="compile">
	    <manifestclasspath property="jar.classpath" jarfile="main.jar">
	      <classpath>
	        <fileset dir="${jr.lib}" includes="*.jar"/>
	      </classpath>
	    </manifestclasspath>

		<!-- Remove the previous build's jar so the classpath never contains
		     two jsplus-tomcat jars at once (only our own jar is matched). -->
		<delete>
			<fileset dir="${jr.lib}/jsplus/default">
				<include name="jsplus-tomcat-*.jar" />
			</fileset>
		</delete>

		<jar jarfile="${jr.lib}/jsplus/default/jsplus-tomcat-${jr.version}.jar" >
			<fileset dir="${jr.classes}">
				<include name="com/**/**/*" />
				<include name="org/**/**/*" />
			</fileset>

			<!--<manifest>-->
			<!--    <attribute name="Main-Class"  value="com.killcoding.jsplus.tomcat.TomcatServer"/>-->
			<!--	<attribute name="Class-Path" value="${jar.classpath}"/>-->
			<!--</manifest>-->
		</jar>
		<echo message="Packaged jsplus-tomcat-${jr.version}.jar" />

		<!-- changes.log: append one history entry to both the English and the
		     Traditional-Chinese copies after every successful package (version
		     + timestamp + optional -Dchange.note="..."). -->
		<tstamp>
			<format property="jr.changelog.ts" pattern="yyyy-MM-dd HH:mm:ss" />
		</tstamp>
		<echo append="true" file="${jr.changelog}"
			message="v${jr.version}  ${jr.changelog.ts}  ${jr.changenote}${line.separator}" />
		<echo append="true" file="${jr.changelog.zh}"
			message="v${jr.version}  ${jr.changelog.ts}  ${jr.changenote}${line.separator}" />
	</target>

	<!-- diff-check: compare this Working tree's src/ java files against the
	     Githubrepos mirror after every build; append differences to changes.log
	     marked "found diffed". Read-only — nothing is copied or committed. The
	     scripts themselves skip when the mirror path is missing. -->
	<target name="diff-check-win" if="is.windows">
		<!-- Normalise the mixed-separator paths (D:\.../test/...) to pure
		     backslash so powershell -File resolves them; the old -File call
		     with forward slashes was rejected ("...does not exist"). -->
		<pathconvert property="jr.diffcheck.script" targetos="windows">
			<path location="${jr.root}/test/diff-check.ps1" />
		</pathconvert>
		<pathconvert property="jr.diffcheck.src" targetos="windows">
			<path location="${jr.root}/src" />
		</pathconvert>
		<pathconvert property="jr.diffcheck.mirror" targetos="windows">
			<path location="${jr.git.repo}/src" />
		</pathconvert>
		<pathconvert property="jr.diffcheck.log" targetos="windows">
			<path location="${jr.changelog}" />
		</pathconvert>
		<pathconvert property="jr.diffcheck.logzh" targetos="windows">
			<path location="${jr.changelog.zh}" />
		</pathconvert>
		<exec executable="powershell.exe" failonerror="false">
			<arg value="-NoProfile" />
			<arg value="-ExecutionPolicy" />
			<arg value="Bypass" />
			<arg value="-File" />
			<arg value="${jr.diffcheck.script}" />
			<arg value="${jr.diffcheck.src}" />
			<arg value="${jr.diffcheck.mirror}" />
			<arg value="${jr.diffcheck.log}" />
			<arg value="${jr.diffcheck.logzh}" />
		</exec>
	</target>
	<target name="diff-check-sh" unless="is.windows">
		<exec executable="sh" failonerror="false">
			<arg value="${jr.root}/test/diff-check.sh" />
			<arg value="${jr.root}/src" />
			<arg value="${jr.git.repo}/src" />
			<arg value="${jr.changelog}" />
			<arg value="${jr.changelog.zh}" />
		</exec>
	</target>
	<target name="diff-check-run" depends="diff-check-win,diff-check-sh" />
	<target name="build" depends="build-init,package,diff-check-run" />
</project>
